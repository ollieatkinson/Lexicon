{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["\"", "\""]
  ],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    { "open": "\"", "close": "\"" }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\t*[^\\t\\s#>].*:\\s*$",
    "decreaseIndentPattern": "^$"
  }
}
